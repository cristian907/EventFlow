# API de EventFlow (worker → API)
API_BASE_URL=http://localhost:3000
INTERNAL_API_KEY=change-me-internal-api-key

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Descubrimiento dinámico de bots (registry)
BOT_POLL_INTERVAL_MS=30000

# Memoria de conversación por chatId (TTL en ms; 30 min)
CONVERSATION_TTL_MS=1800000

# Rate limiting por chatId y límite de turnos a Gemini
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_MESSAGES=5
MAX_GEMINI_TURNS=20

# Logging
LOG_LEVEL=info
