{
    "name": "bot",
    "version": "1.0.0",
    "private": true,
    "description": "EventFlow Telegram bot assistant worker",
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc --project tsconfig.json",
        "start": "tsx src/index.ts",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@eventflow/shared": "workspace:*",
        "@google/genai": "^1.27.0",
        "axios": "^1.7.9",
        "dotenv": "^16.4.7",
        "grammy": "^1.30.0",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^22.14.5",
        "nodemon": "^3.1.9",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
