# Server Configuration
PORT=3000

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# Database Configuration
POSTGRES_USER=eventflow_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=eventflow_db
DATABASE_URL=postgresql://eventflow_user:supersecretpassword@localhost:5432/eventflow_db?schema=public

JWT_SECRET=ultra-secret-jwt-key
JWT_EXPIRES_IN=1h

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Ticket QR Signature Secret
TICKET_QR_SECRET=your-secure-random-secret-here

# Bot Assistant — clave compartida servicio→servicio para el worker del bot
INTERNAL_API_KEY=change-me-internal-api-key
# Clave para cifrar en reposo el token de Telegram (mín. 16 caracteres)
BOT_TOKEN_ENCRYPTION_KEY=change-me-32-byte-encryption-key
BCV_INSECURE_TLS=false
