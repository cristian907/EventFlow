{
    "name": "api",
    "version": "1.0.0",
    "private": true,
    "description": "EventFlow Express API",
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc --project tsconfig.json",
        "start": "tsx src/index.ts",
        "clean": "rm -rf dist",
        "generate": "prisma generate",
        "seed": "tsx prisma/seedUser.ts",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "prisma": {
        "seed": "tsx prisma/seedUser.ts"
    },
    "dependencies": {
        "@eventflow/shared": "workspace:*",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.3",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "ms": "^2.1.3",
        "pg": "^8.21.0",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.14.5",
        "@types/pg": "^8.20.0",
        "nodemon": "^3.1.9",
        "prisma": "^7.8.0",
        "tsx": "^4.19.2"
    }
}
