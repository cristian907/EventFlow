{
    "name": "api",
    "version": "1.0.0",
    "private": true,
    "description": "EventFlow Express API",
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc --project tsconfig.json",
        "start": "node dist/index.js",
        "clean": "rm -rf dist",
        "generate": "prisma generate",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@eventflow/shared": "workspace:*",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.3",
        "pg": "^8.21.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/node": "^22.14.5",
        "@types/pg": "^8.20.0",
        "nodemon": "^3.1.9",
        "prisma": "^7.8.0",
        "tsx": "^4.19.2"
    }
}
