{
  "name": "eventflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "System for event management",
  "scripts": {
    "prepare": "husky",
    "dev": "npm-run-all --parallel dev:*",
    "dev:api": "pnpm --filter api run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @eventflow/shared run build",
    "build:api": "pnpm --filter api run build",
    "build:web": "pnpm --filter web run build",
    "clean": "pnpm -r run clean",
    "type-check": "pnpm -r run type-check",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
